DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# Process-wide protection for expensive full-tree workspace Git scans.
# PAPERCLIP_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# PAPERCLIP_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# PAPERCLIP_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# PAPERCLIP_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---------------------------------------------------------------------------
# MiMi Money AgentOS — multimodal African Financial AI Workforce (sandbox only)
# All defaults work with zero configuration: in-process event transport,
# embedded Memory Bank, ADK local-simulation runtime.
# ---------------------------------------------------------------------------
# Real multimodal Gemini reasoning (omit to run the deterministic local-simulation mode):
# MIMI_GEMINI_API_KEY=
# Mission-critical financial decisions and workflow gates:
# MIMI_GEMINI_MISSION_MODEL=gemini-3.6-flash
# Lightweight support, reporting and escalation tasks:
# MIMI_GEMINI_LIGHT_MODEL=gemini-3.5-flash
# MIMI_GEMINI_MODEL is retained as a legacy alias for the mission model.
# Force a runtime mode: google | local | remote (default: auto — remote wins
# when MIMI_ADK_RUNTIME_URL is set, else gemini when a key is present)
# MIMI_ADK_MODE=google
# Route ADK runs through the real google-adk Python service
# (see services/mimi-adk-runtime; deploy/deploy-cloudrun.sh deploys it):
# MIMI_ADK_RUNTIME_URL=http://localhost:9700
# Real Google services locally via emulators (see deploy/local-emulators.sh):
# PUBSUB_EMULATOR_HOST=localhost:8085
# PUBSUB_PROJECT_ID=mimi-local
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIRESTORE_PROJECT_ID=mimi-local
# Production on Cloud Run just needs:
# GOOGLE_CLOUD_PROJECT=your-project-id
# Display metadata for per-agent Cloud Run workers:
# MIMI_CLOUD_RUN_REGION=africa-south1

# ---------------------------------------------------------------------------
# Live production financial execution requirements
# ---------------------------------------------------------------------------
# The current MiMi workflows are sandbox/simulation-only. These placeholders
# document the inputs required before connecting a real production payment
# rail; they do not enable live money movement by themselves.
#
# Intended payment rail/provider and integration contract:
# MIMI_PAYMENT_RAIL_PROVIDER=circle|stripe|flutterwave|mpesa|bank|blockchain-rpc
# MIMI_PAYMENT_RAIL_API_VERSION=provider-contract-version
# Production Secret Manager secret names (never put credential values here):
# MIMI_PAYMENT_RAIL_CREDENTIAL_SECRET=projects/your-project/secrets/mimi-payment-rail-credentials
# MIMI_PAYMENT_RAIL_SIGNING_SECRET=projects/your-project/secrets/mimi-payment-rail-signing-key
# Supported currencies and networks, agreed with the provider contract:
# MIMI_PRODUCTION_CURRENCIES=USD,EUR,NGN,KES,GHS
# MIMI_PRODUCTION_NETWORKS=provider-network-1,provider-network-2
# Governance requirements to be implemented and approved before activation:
# MIMI_PRODUCTION_APPROVAL_REQUIREMENTS=human-approval-above-threshold
# MIMI_PRODUCTION_COMPLIANCE_REQUIREMENTS=kyc,aml,sanctions
# MIMI_PRODUCTION_TRANSACTION_SIGNING_MODE=provider-managed|hsm|multisig
# MIMI_PRODUCTION_ROLLBACK_REQUIREMENTS=idempotency,compensation,manual-reversal
