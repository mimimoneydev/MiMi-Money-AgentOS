{
  "name": "@mimi/agentos-core",
  "version": "1.0.0",
  "description": "MiMi Money AgentOS core: agent workforce registry, Agent Gateway, deterministic Policy Engine, Pub/Sub-compatible event backbone, Firestore-compatible Memory Bank, Google ADK runtime adapters and the payment workflow orchestrator.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {}
}
