# Copy to .env and fill in. Never commit real keys.
# AI Studio key for local ADK runs (no Google Cloud project needed):
GOOGLE_API_KEY=
# Override the Gemini model used by every agent (defaults to gemini-2.5-flash):
MIMI_GEMINI_MODEL=gemini-2.5-flash
# Run timeout for a single ADK execution:
MIMI_ADK_RUN_TIMEOUT_S=55
